# Server Environment Configuration
# ==============================================================================
# Node Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# Server Port
PORT=5000

# Client Application URL (For CORS whitelist)
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection URL (Prisma ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campus_classifieds?schema=public

# Keycloak Identity Provider (Phase 4 & 6)
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/campus-classifieds
KEYCLOAK_REALM=campus-classifieds
KEYCLOAK_CLIENT_ID=campus-classifieds-web
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/campus-classifieds/protocol/openid-connect/certs
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ==============================================================================
# Production SMTP Provider Settings (Keycloak native - provider-agnostic)
# Development defaults route automatically to Mailpit (localhost:1025 / UI: localhost:8025)
# In production, set these variables in your Docker/environment:
#
# Google Workspace / Personal Gmail:
#   1. Google account must have 2-Step Verification enabled.
#   2. Generate an App Password at: https://myaccount.google.com/apppasswords
#   3. Use that 16-character App Password as KC_SMTP_PASSWORD (NEVER use your regular account password).
#   KC_SMTP_HOST=smtp.gmail.com
#   KC_SMTP_PORT=587
#   KC_SMTP_STARTTLS=true
#   KC_SMTP_AUTH=true
#   KC_SMTP_SSL=false
#   KC_SMTP_FROM=yourgmail@gmail.com
#   KC_SMTP_FROM_DISPLAY=Campus Classifieds
#   KC_SMTP_USER=yourgmail@gmail.com
#   KC_SMTP_PASSWORD=your_16_char_google_app_password
#
# Amazon SES:
#   KC_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
#   KC_SMTP_PORT=587
#   KC_SMTP_STARTTLS=true
#   KC_SMTP_AUTH=true
#   KC_SMTP_USER=your-ses-smtp-username
#   KC_SMTP_PASSWORD=your-ses-smtp-password
#
# SendGrid:
#   KC_SMTP_HOST=smtp.sendgrid.net
#   KC_SMTP_PORT=587
#   KC_SMTP_STARTTLS=true
#   KC_SMTP_AUTH=true
#   KC_SMTP_USER=apikey
#   KC_SMTP_PASSWORD=your-sendgrid-api-key
# ==============================================================================
KC_SMTP_HOST=mailpit
KC_SMTP_PORT=1025
KC_SMTP_FROM=noreply@campus-classifieds.local
KC_SMTP_FROM_DISPLAY=Campus Classifieds
KC_SMTP_AUTH=false
KC_SMTP_STARTTLS=false
KC_SMTP_SSL=false
KC_SMTP_USER=
KC_SMTP_PASSWORD=

# Institutional Email Verification & Delivery (Phase 8)
VERIFICATION_TOKEN_EXPIRES_MINUTES=15
EMAIL_PROVIDER=development
EMAIL_FROM="Campus Classifieds <onboarding@resend.dev>"
EMAIL_API_KEY=your-email-api-key-here

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=campus-classifieds/listings
