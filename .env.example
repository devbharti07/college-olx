# Campus Classifieds Frontend Environment
# ==============================================================================
# API Backend URL
VITE_API_URL=http://localhost:5000

# Keycloak Identity Provider Configuration
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=campus-classifieds
VITE_KEYCLOAK_CLIENT_ID=campus-classifieds-web

# ==============================================================================
# Keycloak SMTP Email Delivery Configuration (Used by docker-compose)
# ==============================================================================
# Development (Mailpit - default):
# Keycloak sends all emails to local Mailpit (Web UI: http://localhost:8025)
KC_SMTP_HOST=mailpit
KC_SMTP_PORT=1025
KC_SMTP_FROM=noreply@campus-classifieds.local
KC_SMTP_FROM_DISPLAY=Campus Classifieds
KC_SMTP_AUTH=false
KC_SMTP_STARTTLS=false
KC_SMTP_SSL=false
KC_SMTP_USER=
KC_SMTP_PASSWORD=

# ==============================================================================
# Real Gmail Delivery (Production / Staging):
# ------------------------------------------------------------------------------
# 1. Google Account MUST have 2-Step Verification enabled.
# 2. Generate a dedicated Google App Password at: https://myaccount.google.com/apppasswords
# 3. Use that 16-character App Password as KC_SMTP_PASSWORD (NEVER use your regular account password).
# ------------------------------------------------------------------------------
# KC_SMTP_HOST=smtp.gmail.com
# KC_SMTP_PORT=587
# KC_SMTP_FROM=yourgmail@gmail.com
# KC_SMTP_FROM_DISPLAY=Campus Classifieds
# KC_SMTP_AUTH=true
# KC_SMTP_STARTTLS=true
# KC_SMTP_SSL=false
# KC_SMTP_USER=yourgmail@gmail.com
# KC_SMTP_PASSWORD=your_google_app_password
